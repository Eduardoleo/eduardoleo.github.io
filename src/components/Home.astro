---
import Pipeline from './Pipeline.astro';
import profile from '../data/profile.json';
import data from '../data/projects.json';
import services from '../data/services.json';
import { ui, paths, formatMonth, type Lang } from '../i18n/ui';
import { priceValue, formatCRC } from '../scripts/pricing';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const projects = [...data.projects].sort((a, b) => a.order - b.order);
const c = profile.contact;
const formKey = c.web3formsKey.trim();

const esc = (s: string) => s.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]!);
// Resalta los porcentajes reales (67 %, 75 %) del texto de experiencia.
const highlight = (s: string) => esc(s).replace(/(\d+\s?%)/g, '<strong>$1</strong>');
const range = (start: string, end: string | null) => `${formatMonth(start, lang)} – ${end ? formatMonth(end, lang) : t.present}`;

// Servicios (src/data/services.json): "Desde ₡X" o "Precio a consultar" si es POR_DEFINIR.
const priceLabel = (v: unknown) => {
  const n = priceValue(v);
  return n === null ? t.priceOnRequest : `${t.priceFrom} ${formatCRC(n, lang)}`;
};
const projectTitle = (slug: string) => data.projects.find((p) => p.slug === slug)?.[lang].title ?? slug;
// La calculadora lee la línea y el paquete de la URL (los mismos nombres de parámetro en ES y EN).
const quoteHref = (line: string, pkg: string) => `${paths[lang].quote}?linea=${line}&paquete=${pkg}`;
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">{profile.name} · {profile.title[lang]}</p>
      <h1>{t.heroTitle}</h1>
      <div>
      <p class="lead">{t.heroLead}</p>
      <div class="actions">
        <a class="button wa-link" href="#contacto" data-wa={c.whatsapp.code} data-msg={c.whatsapp.message[lang]} rel="noopener noreferrer">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3Z"/></svg>
          {t.ctaWhatsapp}<span class="sr-only" data-wa-newtab hidden> {t.newTab}</span>
        </a>
        <a class="button ghost" href="#proyectos">{t.ctaProjects}</a>
      </div>
      <p class="hero-note">{t.quote}</p>
      </div>
    </div>
    <Pipeline lang={lang} />
  </div>
</section>

<section class="block" id="servicios" aria-labelledby="servicios-t">
  <div class="wrap">
    <div class="block-head">
      <h2 id="servicios-t">{t.servicesTitle}</h2>
      <p>{t.servicesLead}</p>
    </div>
    {services.lineas.map((line) => (
      <article class="line" id={`linea-${line.id}`} aria-labelledby={`linea-${line.id}-t`}>
        <div class="line-head">
          <p class="line-tag">{t.lineLabel} {line.id.toUpperCase()}</p>
          <h3 id={`linea-${line.id}-t`}>{line[lang].nombre}</h3>
          <p class="line-problem">{line[lang].problema}</p>
          <p class="line-example">
            <a href={paths[lang].project(line.proyecto)}>{t.seeExample}<span class="sr-only">: {projectTitle(line.proyecto)}</span></a>
          </p>
        </div>
        <ul class="packages">
          {line.paquetes.map((pkg) => (
            <li class="package" data-package={pkg.id}>
              <h4>{pkg[lang].nombre}</h4>
              <p class="package-includes"><span class="sr-only">{t.includes}: </span>{pkg[lang].incluye}</p>
              <dl class="package-meta">
                <div><dt>{t.term}</dt><dd>{pkg[lang].plazo}</dd></div>
              </dl>
              <p class="package-price">{priceLabel(pkg.precio_desde)}</p>
              <a class="button ghost package-cta" href={quoteHref(line.id, pkg.id)} aria-label={`${t.quoteCta}: ${pkg[lang].nombre}`}>{t.quoteCta}</a>
            </li>
          ))}
        </ul>
      </article>
    ))}
    <div class="included">
      <h3 id="incluido-t">{t.includedTitle}</h3>
      <ul>
        {services.incluido.map((inc) => (
          <li>
            <h4>{inc[lang].titulo}</h4>
            <p>{inc[lang].texto}</p>
          </li>
        ))}
      </ul>
    </div>
    <div class="quote-line">
      <p>{t.quote}</p>
      <a class="button ghost" href={paths[lang].quote}>{t.calcCta}</a>
    </div>
  </div>
</section>

<section class="block" id="experiencia" aria-labelledby="experiencia-t">
  <div class="wrap">
    <div class="block-head">
      <h2 id="experiencia-t">{t.experienceTitle}</h2>
      <p>{t.experienceLead}</p>
    </div>
    <ol class="timeline">
      {profile.experience.map((job) => (
        <li class:list={['job', { current: !job.end }]}>
          <p class="job-when">{range(job.start, job.end)}</p>
          <div>
            <h3>{job[lang].role}</h3>
            <p class="job-company">{job.company}</p>
            <ul>{job[lang].points.map((pt) => <li set:html={highlight(pt)} />)}</ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="block" id="proyectos" aria-labelledby="proyectos-t">
  <div class="wrap">
    <div class="block-head">
      <h2 id="proyectos-t">{t.projectsTitle}</h2>
      <p>{t.projectsLead}</p>
    </div>
    <ul class="projects">
      {projects.map((p) => (
        <li class:list={['project', { featured: p.featured }]}>
          <p class="project-kind">{p[lang].kind}</p>
          <h3>{p.case ? <a href={paths[lang].project(p.slug)}>{p[lang].title}</a> : p[lang].title}</h3>
          <p>{p[lang].summary}</p>
          <ul class="tags" aria-label="Stack">{p.stack.map((s) => <li>{s}</li>)}</ul>
          <div class="project-foot">
            {p.case
              ? <a class="button ghost" href={paths[lang].project(p.slug)} aria-label={`${t.readCase}: ${p[lang].title}`}>{t.readCase}</a>
              : <span class="status">{t.casePending}</span>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="block" id="sobre-mi" aria-labelledby="sobre-mi-t">
  <div class="wrap about-grid">
    <div class="portrait">
      {profile.photo
        ? <img src={profile.photo} alt={profile.name} width="360" height="450" loading="lazy" decoding="async" />
        : <span class="monogram" aria-hidden="true">{profile.initials}</span>}
    </div>
    <div>
      <h2 id="sobre-mi-t">{t.aboutTitle}</h2>
      {t.about.map((para) => <p>{para}</p>)}
      <h3 class="sr-only">{t.skillsTitle}</h3>
      <div class="facts">
        {profile.skills.map((g) => (
          <div>
            <h3>{g[lang]}</h3>
            <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="block" id="formacion" aria-labelledby="formacion-t">
  <div class="wrap">
    <div class="block-head"><h2 id="formacion-t">{t.educationTitle}</h2></div>
    <div class="edu">
      <div>
        <h3>{lang === 'es' ? 'Universidad' : 'University'}</h3>
        {profile.education.map((e) => (
          <div class="edu-item">
            <p class="title">{e[lang].title}</p>
            <p>{e[lang].org}</p>
            <p class="meta">{range(e.start, e.end)} · {e[lang].note}</p>
          </div>
        ))}
      </div>
      <div>
        <h3>{t.coursesTitle}</h3>
        {profile.courses.map((co) => (
          <div class="edu-item">
            <p class="title">{co[lang].title}</p>
            <p class="meta">{co[lang].org} · {co.year}</p>
          </div>
        ))}
      </div>
      {profile.certifications.length > 0 && (
        <div>
          <h3>{t.certificationsTitle}</h3>
          {profile.certifications.map((ce: any) => (
            <div class="edu-item">
              <p class="title">{ce[lang].title}</p>
              <p class="meta">{ce[lang].org} · {ce.year}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<section class="block" id="contacto" aria-labelledby="contacto-t">
  <div class="wrap">
    <div class="block-head">
      <h2 id="contacto-t">{t.contactTitle}</h2>
      <p>{t.contactLead}</p>
    </div>
    <div class="contact-grid">
      <form class="form" action="https://api.web3forms.com/submit" method="POST" novalidate data-ready={formKey ? 'true' : 'false'}
        data-sending={t.form.sending} data-ok={t.form.ok} data-error={t.form.error} data-invalid={t.form.invalid}>
        <input type="hidden" name="access_key" value={formKey} />
        <input type="hidden" name="subject" value={lang === 'es' ? 'Nuevo mensaje desde el portafolio' : 'New message from the portfolio'} />
        <input type="hidden" name="from_name" value="Portafolio" />
        <div class="hp" aria-hidden="true">
          <label for={`botcheck-${lang}`}>{t.form.honeypot}</label>
          <input type="checkbox" name="botcheck" id={`botcheck-${lang}`} tabindex="-1" autocomplete="off" />
        </div>
        <div class="field">
          <label for="f-name">{t.form.name}</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="100" />
        </div>
        <div class="field">
          <label for="f-email">{t.form.email}</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="150" />
        </div>
        <div class="field">
          <label for="f-msg">{t.form.message}</label>
          <p class="hint" id="f-msg-hint">{t.form.messageHint}</p>
          <textarea id="f-msg" name="message" required minlength="10" maxlength="3000" aria-describedby="f-msg-hint"></textarea>
        </div>
        <p class="form-note">{t.form.privacy} <a href={paths[lang].privacy}>{t.form.privacyLink}</a>.</p>
        {!formKey && <p class="form-note notice"><span>{t.form.unavailable}</span></p>}
        <div><button class="button" type="submit" disabled={!formKey}>{t.form.submit}</button></div>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
      <aside class="channels" aria-labelledby="directo-t">
        <h3 id="directo-t">{t.direct}</h3>
        <a class="button wa-link" href="#contacto" data-wa={c.whatsapp.code} data-msg={c.whatsapp.message[lang]} rel="noopener noreferrer">
          {t.whatsapp}<span class="sr-only" data-wa-newtab hidden> {t.newTab}</span>
        </a>
        <a class="button ghost" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">{t.linkedin}<span class="sr-only"> {t.newTab}</span></a>
        <a class="button ghost" href={profile.links.github} target="_blank" rel="noopener noreferrer">{t.github}<span class="sr-only"> {t.newTab}</span></a>
        {c.cv.enabled && <a class="button ghost" href={c.cv.file[lang]} download type="application/pdf">{t.cv}</a>}
        <p class="form-note">{t.quote}</p>
      </aside>
    </div>
  </div>
</section>

<script>
  import { initWhatsAppLinks } from '../scripts/whatsapp';
  import { trackContactSent } from '../scripts/analytics';

  // WhatsApp: el número no está en el HTML; se arma al interactuar (ver src/scripts/whatsapp.ts).
  initWhatsAppLinks();

  // Formulario: envío con fetch a Web3Forms, validación accesible y honeypot.
  const form = document.querySelector<HTMLFormElement>('form.form');
  if (form && form.dataset.ready === 'true') {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]')];
      let firstBad: HTMLElement | null = null;
      fields.forEach((f) => {
        const bad = !f.checkValidity() || !f.value.trim();
        f.setAttribute('aria-invalid', String(bad));
        if (bad && !firstBad) firstBad = f;
      });
      if (firstBad) {
        status.dataset.state = 'error';
        status.textContent = form.dataset.invalid ?? '';
        (firstBad as HTMLElement).focus();
        return;
      }
      const data = new FormData(form);
      if (data.get('botcheck')) return; // bot: se descarta en silencio
      button.disabled = true;
      status.dataset.state = '';
      status.textContent = form.dataset.sending ?? '';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error('send');
        form.reset();
        status.dataset.state = 'ok';
        status.textContent = form.dataset.ok ?? '';
        trackContactSent();
      } catch {
        status.dataset.state = 'error';
        status.textContent = form.dataset.error ?? '';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
