---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ui, paths, type Lang } from '../i18n/ui';

interface Props { lang: Lang; project: any }
const { lang, project } = Astro.props;
const t = ui[lang];
const c = project[lang];
const s = t.caseSections;
const home = paths[lang].home;
const short = { es: { finding: 'Hallazgo', security: 'Caso de seguridad' }, en: { finding: 'Finding', security: 'Security case' } }[lang];

// Medios del caso: archivos en src/assets/proyectos/<slug>/, declarados en projects.json.
// - screenshots: [{ file, es/en: { alt, caption } }] → <Picture> AVIF + WebP, con width/height y carga diferida.
// - video: { mp4, webm?, poster, es/en: { caption, description } } → <video> silenciado, con controles y póster.
// - media_note: { es, en } opcional, aclaración sobre los datos que se ven (p. ej. que son ficticios).
// Si no hay capturas ni video, la sección no se genera (sin huecos).
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/proyectos/*/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const videos = import.meta.glob<string>('../assets/proyectos/*/*.{mp4,webm}', { eager: true, query: '?url', import: 'default' });
const findAsset = (file: string) => {
  const mod = assets[`../assets/proyectos/${project.slug}/${file}`];
  if (!mod) throw new Error(`Imagen no encontrada: ${project.slug}/${file}`);
  return mod.default;
};
const shots = await Promise.all((project.screenshots ?? []).map(async (sh: any) => {
  const src = findAsset(sh.file);
  const full = await getImage({ src, format: 'webp', width: Math.min(src.width, 1440) });
  return { src, full: full.src, alt: sh[lang].alt, caption: sh[lang].caption };
}));
let video: null | { mp4: string; webm?: string; poster: string; width: number; height: number; caption: string; description: string } = null;
if (project.video) {
  const v = project.video;
  const url = (file: string) => {
    const u = videos[`../assets/proyectos/${project.slug}/${file}`];
    if (!u) throw new Error(`Video no encontrado: ${project.slug}/${file}`);
    return u;
  };
  const posterSrc = findAsset(v.poster);
  const poster = await getImage({ src: posterSrc, format: 'webp', width: Math.min(posterSrc.width, 1280) });
  video = {
    mp4: url(v.mp4),
    webm: v.webm ? url(v.webm) : undefined,
    poster: poster.src,
    width: posterSrc.width,
    height: posterSrc.height,
    caption: v[lang].caption,
    description: v[lang].description,
  };
}
const hasMedia = shots.length > 0 || video !== null;

const sections: [string, string][] = [
  ['problema', s.problem],
  ['rol', s.role],
  ['solucion', s.solution],
  ...(hasMedia ? [['capturas', s.screenshots] as [string, string]] : []),
  ...(c.finding ? [['hallazgo', short.finding] as [string, string]] : []),
  ['decisiones', s.decisions],
  ...(c.security ? [['seguridad', short.security] as [string, string]] : []),
  ['resultados', s.results],
  ['alcance', s.limits],
];
---
<article>
  <header class="case-head">
    <div class="wrap">
      <a class="back" href={`${home}#proyectos`}>{t.backToProjects}</a>
      <p class="project-kind">{c.kind} · {project.year}</p>
      <h1>{c.title}</h1>
      <p class="lead">{c.summary}</p>
      <ul class="tags" aria-label="Stack">{project.stack.map((x: string) => <li>{x}</li>)}</ul>
      {project.repo && <p class="case-links"><a class="button ghost" href={project.repo} rel="noopener">{t.viewCode}</a></p>}
    </div>
  </header>
  <div class="wrap case-layout">
    <nav class="case-index" aria-label={t.caseIndex}>
      <p>{t.caseIndex}</p>
      {sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    </nav>
    <div class="case-body">
      <section id="problema" aria-labelledby="problema-t"><h2 id="problema-t">{s.problem}</h2><p>{c.problem}</p></section>
      <section id="rol" aria-labelledby="rol-t"><h2 id="rol-t">{s.role}</h2><p>{c.role}</p></section>
      <section id="solucion" aria-labelledby="solucion-t">
        <h2 id="solucion-t">{s.solution}</h2>
        <p>{c.solution}</p>
        {c.architecture && <ol class="arch" aria-label={s.solution}>{c.architecture.map((a: string) => <li>{a}</li>)}</ol>}
      </section>
      {hasMedia && (
        <section id="capturas" aria-labelledby="capturas-t">
          <h2 id="capturas-t">{s.screenshots}</h2>
          {project.media_note?.[lang] && <p class="shots-note">{project.media_note[lang]}</p>}
          {shots.length > 0 && (
            <div class="shots">
              {shots.map((sh: any) => (
                <figure class="shot">
                  <a href={sh.full} aria-label={`${t.screenshotOpen}: ${sh.caption}`}>
                    <Picture src={sh.src} alt={sh.alt} width={720} formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" decoding="async" />
                  </a>
                  <figcaption>{sh.caption}</figcaption>
                </figure>
              ))}
            </div>
          )}
          {video && (
            <figure class="shot demo-video">
              <video controls muted playsinline preload="none" poster={video.poster} width={video.width} height={video.height} aria-describedby="video-desc">
                {video.webm && <source src={video.webm} type="video/webm" />}
                <source src={video.mp4} type="video/mp4" />
              </video>
              <figcaption>{video.caption}<span id="video-desc" class="video-desc">{video.description}</span></figcaption>
            </figure>
          )}
        </section>
      )}
      {c.finding && (
        <section id="hallazgo" class="highlight-block" aria-labelledby="hallazgo-t">
          <h2 id="hallazgo-t">{c.finding.title}</h2>
          <dl class="findings">
            {c.finding.items.map((it: any) => (<div><dt>{it.label}</dt><dd>{it.body}</dd></div>))}
          </dl>
        </section>
      )}
      <section id="decisiones" aria-labelledby="decisiones-t">
        <h2 id="decisiones-t">{s.decisions}</h2>
        {c.decisions.map((d: any) => (
          <div class="decision"><h3>{d.title}</h3><p>{d.body}</p></div>
        ))}
      </section>
      {c.security && (
        <section id="seguridad" class="highlight-block" aria-labelledby="seguridad-t">
          <h2 id="seguridad-t">{c.security.title}</h2>
          <dl class="findings">
            {c.security.items.map((it: any) => (<div><dt>{it.label}</dt><dd>{it.body}</dd></div>))}
          </dl>
        </section>
      )}
      <section id="resultados" aria-labelledby="resultados-t">
        <h2 id="resultados-t">{s.results}</h2>
        <ul class="checklist">{c.results.map((r: string) => <li>{r}</li>)}</ul>
      </section>
      <section id="alcance" aria-labelledby="alcance-t">
        <h2 id="alcance-t">{s.limits}</h2>
        <ul class="limits">{c.limits.map((l: string) => <li>{l}</li>)}</ul>
      </section>
      <div class="case-cta">
        <h2>{t.caseContact}</h2>
        <p>{t.caseContactBody}</p>
        <p class="case-links">
          <a class="button" href={`${home}#contacto`}>{t.nav.contact}</a>
          {project.repo && <a class="button ghost" href={project.repo} rel="noopener">{t.viewCode}</a>}
        </p>
      </div>
    </div>
  </div>
</article>
