---
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = ui[lang].pipeline;
---
<figure class="pipeline" role="img" aria-label={ui[lang].pipelineLabel}>
  <div class="pipe-grid" aria-hidden="true">
    <ul class="pipe-col in">
      {p.in.map((label) => <li class="pipe-node">{label}</li>)}
    </ul>
    <svg class="pipe-link" viewBox="0 0 36 144" preserveAspectRatio="none">
      <path d="M0 24 C 20 24, 16 72, 36 72" />
      <path d="M0 72 L 36 72" />
      <path d="M0 120 C 20 120, 16 72, 36 72" />
      <path class="flow" d="M0 24 C 20 24, 16 72, 36 72 M0 72 L36 72 M0 120 C 20 120, 16 72, 36 72" />
    </svg>
    <span class="pipe-down"></span>
    <div class="pipe-core">
      <strong>{p.core}</strong>
      <ol>{p.steps.map((s) => <li>{s}</li>)}</ol>
    </div>
    <svg class="pipe-link" viewBox="0 0 36 144" preserveAspectRatio="none">
      <path d="M0 72 C 20 72, 16 40, 36 40" />
      <path d="M0 72 C 20 72, 16 104, 36 104" />
      <path class="flow" d="M0 72 C 20 72, 16 40, 36 40 M0 72 C 20 72, 16 104, 36 104" />
    </svg>
    <span class="pipe-down"></span>
    <ul class="pipe-col out">
      <li class="pipe-node out">{p.out[0]}</li>
      <li class="pipe-node out">
        {p.out[1]}
        <span class="pipe-secure">
          <svg viewBox="0 0 16 16" width="12" height="12"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="currentColor"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          {p.secure}
        </span>
      </li>
    </ul>
  </div>
</figure>
